// or a DOM-shimmed host); a plain Node/Bun SSR import skips it.
if (typeof HTMLElement !== 'undefined' && typeof customElements !== 'undefined') {
  defineElement('v2-exposed', defineComponent({
  props: {
    label: { value: 'hi' }
