import { defineComponent, defineElement, _registerAgentServerBinding } from '@aihu/runtime'
import { __aihu_eattr, __aihu_stext } from '@aihu/runtime/ssr'

const __aihu_setup__ = (ctx) => {
  const label = ctx.props.label

  const [count, setCount] = signal(0)

  const shout = computed(() => label().toUpperCase());
  function bump() { return batch(() => { setCount(count() + 1) }) }
  _registerAgentServerBinding(ctx?.element, {
    tag: 'v2-exposed',
    actions: {
      bump: (args) => bump(args)
    },
    reads: {
      label: () => label(),
      shout: () => shout()
    },
    writes: {
      label: (v) => label.set(v)
    },
    scope: 'user:write',
    rateLimit: '30/min',
  })
  return branch('div', undefined, [leaf([() => label() as unknown as string, () => {}] as unknown as Signal<string>)])
}

